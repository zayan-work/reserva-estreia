# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local reservation data (Estreia file store)
.data/

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (secrets stay local; the example templates are committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tmp and scripts
tmp/
scripts/

# brand source material — large binaries kept out of git
*.zip
/image.png

# browser test artifacts
.playwright-mcp/

# office suite lock files
.~lock.*#
