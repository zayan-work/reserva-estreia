# =========================================================================
# Meridiano · meridianocasa.com
#
# Copy this file to `.env.local` for local development, and set the same
# values in the Vercel project for Production.
#
#   cp apps/meridiano/.env.example apps/meridiano/.env.local
#
# `.env.local` is gitignored. This file is the committed template, so never
# put a real secret in it.
#
# Nothing here is required for the site to render. Only the contact form's
# destination depends on configuration.
# =========================================================================


# -------------------------------------------------------------------------
# Public site URL
# -------------------------------------------------------------------------
# Drives the canonical link, the sitemap, hreflang alternates and Open Graph.
# A bare host works too; lib/site.ts prepends https:// and trims any trailing
# slash. Vercel lists domains without a scheme, so that is the usual paste.
#
# Resolution order in lib/site.ts, first match wins:
#   1. NEXT_PUBLIC_SITE_URL              (this variable)
#   2. VERCEL_PROJECT_PRODUCTION_URL     (injected by Vercel, production)
#   3. VERCEL_URL                        (injected by Vercel, previews)
#   4. https://meridianocasa.com         (fallback)
#
# Because of 2 and 3 you can leave this unset on Vercel and preview deploys
# will still generate correct absolute URLs for themselves. Set it explicitly
# on Production so the canonical never points at a *.vercel.app address.
#
# Local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://meridianocasa.com


# -------------------------------------------------------------------------
# Contact form destination
# -------------------------------------------------------------------------
# Where a submitted message is delivered. Any endpoint that accepts a JSON
# POST and forwards to hello@meridianocasa.com: a Zapier catch hook, a Make
# scenario, or a Google Apps Script web app.
#
# The route posts:
#   { message, locale, receivedAt, source }
#
# Leave this UNSET in development. app/api/contact/route.ts then logs the
# message to the server console and still answers 200, so the form can be
# reviewed on staging before the mailbox exists. Nothing is silently dropped.
#
# REQUIRED before launch, or real enquiries only ever reach the Vercel log.
# CONTACT_WEBHOOK_URL=https://script.google.com/macros/s/XXXXXXXX/exec


# -------------------------------------------------------------------------
# Analytics
# -------------------------------------------------------------------------
# There are deliberately no analytics variables. The handoff, section 06:
# no Google Analytics, no Meta Pixel, no third-party trackers at launch.
# The audience is small, professional and privacy-conscious.
#
# When traffic data is genuinely needed, add self-hosted Plausible or Umami
# and nothing else. Do not reach for a hosted tracker.
