# ─────────────────────────────────────────────────────────────────────────
# Estreia — Reservation site environment
# Copy to `.env.local` for local dev, and set these in your host for prod.
# NOTHING here turns on payments. There is no payment/Pix config by design.
# ─────────────────────────────────────────────────────────────────────────

# Public site URL — used for SEO canonical, sitemap, Open Graph.
# Confirm the final domain/brand with Rengan before going live (Spec §1.5).
# A bare host works too; lib/site.ts prepends https:// and trims any trailing
# slash. Vercel lists domains without a scheme, so that is the usual paste.
NEXT_PUBLIC_SITE_URL=https://reserva.estreia.com.br

# Internal dashboard (/painel) Basic Auth. CHANGE THESE for every environment.
# The dashboard never faces the public (Spec §6).
PAINEL_USER=estreia
PAINEL_PASSWORD=trocar-esta-senha

# Where reservations are persisted.
# - Default: a JSON file under DATA_DIR (durable on any persistent host).
# - On a persistent host, point this at a writable, backed-up volume.
DATA_DIR=.data

# Real destination mirror (Spec §1.3). Every reservation is ALSO POSTed here.
# Use a Google Sheet / Airtable / CRM endpoint via Zapier, Make, or a Google
# Apps Script web app. REQUIRED for serverless hosts (e.g. Vercel), where the
# file store above is ephemeral. Leave blank to disable the mirror.
# RESERVATIONS_WEBHOOK_URL=https://script.google.com/macros/s/XXXX/exec

# Analytics — privacy-friendly, LGPD-clean (Spec §1.4). Leave blank to disable.
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=reserva.estreia.com.br
# Optional self-hosted Plausible script URL (defaults to plausible.io).
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js

# Production decision threshold shown on the dashboard (Spec §6). Tune w/ Rengan.
# DECISION_THRESHOLD=500
